  navigationLabel     String?                  @db.VarChar(80)
  pageType            String                   @db.VarChar(40)
  status              MarketingPageStatus      @default(DRAFT)
  draftContent        Json
  publishedContent    Json?
  seoTitle            String?                  @db.VarChar(70)
  seoDescription      String?                  @db.VarChar(170)
  ogTitle             String?                  @db.VarChar(70)
  ogDescription       String?                  @db.VarChar(170)
  socialImageId       String?                  @db.Uuid
  version             Int                      @default(1)
  publishedRevisionId String?                  @unique @db.Uuid
  createdByUserId     String                   @db.Uuid
  updatedByUserId     String                   @db.Uuid
  publishedByUserId   String?                  @db.Uuid
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  publishedAt         DateTime?
  createdBy           User                     @relation("MarketingPageCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User                     @relation("MarketingPageUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
