  sortOrder Int
  caption   String?                  @db.VarChar(500)
  createdAt DateTime                 @default(now())
  project   BeforeAfterProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     MediaAsset               @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([projectId, mediaId])
  @@unique([projectId, sortOrder])
  @@index([mediaId])
  @@index([projectId, category, sortOrder])
}

model MarketingPage {
  id                  String                   @id @default(uuid()) @db.Uuid
