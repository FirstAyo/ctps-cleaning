model MediaAsset {
  id               String                    @id @default(uuid()) @db.Uuid
  storageKey       String                    @unique @db.VarChar(240)
  visibility       MediaVisibility           @default(PRIVATE)
  status           MediaStatus               @default(READY)
  originalFilename String                    @db.VarChar(255)
  storedFilename   String                    @db.VarChar(100)
  mimeType         String                    @db.VarChar(100)
  sizeBytes        Int
  width            Int
  height           Int
  altText          String                    @default("") @db.VarChar(300)
  caption          String?                   @db.VarChar(500)
  checksum         String                    @db.Char(64)
  uploadedByUserId String                    @db.Uuid
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  archivedAt       DateTime?
