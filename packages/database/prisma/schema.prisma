generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

enum MediaStatus {
  READY
  ARCHIVED
}

enum MediaVariantKind {
  ORIGINAL
  LARGE
  GALLERY
  THUMBNAIL
}

enum BeforeAfterProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BeforeAfterMediaCategory {
  BEFORE
  AFTER
  GALLERY
}

enum QuoteRequestStatus {
  NEW
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  ESTIMATE_REVIEWED
  QUOTE_PREPARED
  CONTACTED
  ACCEPTED
  DECLINED
  CLOSED
  CANCELLED
}

enum QuotePropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum QuoteUploadStatus {
  READY
  REMOVED
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
}

enum PricingVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingRuleType {
  FIXED_RANGE_ADDITION
  FIXED_RANGE_REPLACEMENT
  PER_UNIT_RANGE
  PERCENTAGE_RANGE_ADJUSTMENT
  TIER_RANGE
  MINIMUM_CHARGE
  SERVICE_AREA_RANGE_ADDITION
  CUSTOMER_TYPE_RANGE_ADDITION
  MANUAL_REVIEW
}

enum PricingConditionOperator {
  EQUALS
  NOT_EQUALS
  IN
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  BOOLEAN_TRUE
  BOOLEAN_FALSE
}

enum EstimateOutcome {
  RANGE
  MANUAL_REVIEW
}

enum EstimateMatchStatus {
  NOT_LINKED
  MATCHED
  INPUTS_CHANGED
  EXPIRED
}

enum BlogPostStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogContentFormat {
  STRUCTURED_BLOCKS
}

enum BlogMediaVisibility {
  PRIVATE
  PUBLIC
}

enum BlogMediaStatus {
  READY
  ARCHIVED
}

enum BlogMediaVariantKind {
  ORIGINAL
  FEATURED
  ARTICLE_LARGE
  ARTICLE_STANDARD
  THUMBNAIL
}

enum ServiceJobStatus {
  DRAFT
  READY_TO_SCHEDULE
  SCHEDULED
  CONFIRMED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  PAUSED
  COMPLETED
  FOLLOW_UP_REQUIRED
  CANCELLED
  CLOSED
  ARCHIVED
}

enum ServiceJobAssignmentRole {
  LEAD
  CREW_MEMBER
  COORDINATOR
}

enum ServiceJobChecklistCategory {
  PREPARATION
  ARRIVAL
  SERVICE
  SAFETY
  CLEANUP
  COMPLETION
}

enum ServiceJobNoteVisibility {
  INTERNAL
  CUSTOMER_FACING
}

enum ServiceJobMediaCategory {
  BEFORE
  DURING
  AFTER
  ACCESS
  ISSUE
  COMPLETION
  OTHER
}

enum ServiceJobMediaVariantKind {
  ORIGINAL
  LARGE
  STANDARD
  THUMBNAIL
}

enum ServiceJobIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MarketingPageStatus {
  DRAFT
  PUBLISHED
}

enum PublicMediaStatus {
  READY
  ARCHIVED
}

enum PublicMediaVariantKind {
  ORIGINAL
  HERO
  LARGE
  STANDARD
  CARD
  THUMBNAIL
}

model User {
  id                         String                      @id @default(uuid()) @db.Uuid
  email                      String                      @unique @db.VarChar(254)
  displayName                String                      @db.VarChar(100)
  passwordHash               String                      @db.Text
  status                     UserStatus                  @default(ACTIVE)
  mustChangePassword         Boolean                     @default(true)
  lastLoginAt                DateTime?
  passwordChangedAt          DateTime?
  disabledAt                 DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  roles                      UserRole[]
  sessions                   Session[]
  auditLogs                  AuditLog[]                  @relation("AuditActor")
  uploadedMedia              MediaAsset[]                @relation("MediaUploader")
  createdBeforeAfterProjects BeforeAfterProject[]        @relation("BeforeAfterCreatedBy")
  updatedBeforeAfterProjects BeforeAfterProject[]        @relation("BeforeAfterUpdatedBy")
  assignedQuoteRequests      QuoteRequest[]              @relation("QuoteRequestAssignee")
  quoteRequestNotes          QuoteRequestNote[]
  quoteStatusChanges         QuoteRequestStatusHistory[]
  createdPricingVersions     PricingVersion[]            @relation("PricingVersionCreatedBy")
  updatedPricingVersions     PricingVersion[]            @relation("PricingVersionUpdatedBy")
  blogPosts                  BlogPost[]                   @relation("BlogPostAuthor")
  blogRevisions              BlogPostRevision[]           @relation("BlogRevisionActor")
  uploadedBlogMedia          BlogMediaAsset[]             @relation("BlogMediaUploader")
  authorProfile              AuthorProfile?
  createdServiceJobs         ServiceJob[]                 @relation("ServiceJobCreatedBy")
  updatedServiceJobs         ServiceJob[]                 @relation("ServiceJobUpdatedBy")
  coordinatedServiceJobs     ServiceJob[]                 @relation("ServiceJobCoordinator")
  serviceJobAssignments      ServiceJobAssignment[]       @relation("ServiceJobAssignee")
  assignedServiceJobs        ServiceJobAssignment[]       @relation("ServiceJobAssignedBy")
  serviceJobScheduleChanges  ServiceJobScheduleHistory[]  @relation("ServiceJobScheduleActor")
  serviceJobStatusChanges    ServiceJobStatusHistory[]    @relation("ServiceJobStatusActor")
  serviceJobNotes            ServiceJobNote[]             @relation("ServiceJobNoteAuthor")
  completedChecklistItems    ServiceJobChecklistItem[]    @relation("ServiceJobChecklistCompleter")
  uploadedServiceJobMedia    ServiceJobMedia[]             @relation("ServiceJobMediaUploader")
  reportedServiceIncidents   ServiceJobIncident[]          @relation("ServiceJobIncidentReporter")
  resolvedServiceIncidents   ServiceJobIncident[]          @relation("ServiceJobIncidentResolver")
  serviceJobActivities       ServiceJobActivity[]          @relation("ServiceJobActivityActor")
  createdMarketingPages      MarketingPage[]               @relation("MarketingPageCreatedBy")
  updatedMarketingPages      MarketingPage[]               @relation("MarketingPageUpdatedBy")
  publishedMarketingPages    MarketingPage[]               @relation("MarketingPagePublishedBy")
  marketingPageRevisions     MarketingPageRevision[]       @relation("MarketingPageRevisionActor")
  uploadedPublicMedia        PublicMediaAsset[]             @relation("PublicMediaUploader")
  updatedNavigationItems     NavigationItem[]               @relation("NavigationItemUpdater")
  updatedSiteSettings        SiteSetting[]                  @relation("SiteSettingUpdater")

  @@index([status])
  @@index([createdAt])
}

model AuthorProfile {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  slug           String          @unique @db.VarChar(100)
  displayName    String          @db.VarChar(100)
  bio            String          @default("") @db.VarChar(1000)
  profileMediaId String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileMedia   BlogMediaAsset? @relation("AuthorProfileMedia", fields: [profileMediaId], references: [id], onDelete: SetNull)

  @@index([profileMediaId])
}

model BlogPost {
  id                 String            @id @default(uuid()) @db.Uuid
  slug               String            @unique @db.VarChar(120)
  title              String            @db.VarChar(180)
  excerpt            String            @db.VarChar(500)
  content            Json
  searchText         String            @default("") @db.Text
  contentFormat      BlogContentFormat @default(STRUCTURED_BLOCKS)
  status             BlogPostStatus    @default(DRAFT)
  authorUserId       String            @db.Uuid
  featuredMediaId    String?           @db.Uuid
  seoTitle           String?           @db.VarChar(70)
  seoDescription     String?           @db.VarChar(170)
  publishedAt        DateTime?
  scheduledFor       DateTime?
  archivedAt         DateTime?
  readingTimeMinutes Int               @default(1)
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  author             User              @relation("BlogPostAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  featuredMedia      BlogMediaAsset?   @relation("BlogFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: Restrict)
  categories         BlogPostCategory[]
  tags               BlogPostTag[]
  media              BlogPostMedia[]
  revisions          BlogPostRevision[]
  redirects          BlogSlugRedirect[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, scheduledFor])
  @@index([authorUserId, status, updatedAt(sort: Desc)])
  @@index([featuredMediaId])
}

model BlogPostRevision {
  id                   String            @id @default(uuid()) @db.Uuid
  postId               String            @db.Uuid
  revisionNumber       Int
  title                String            @db.VarChar(180)
  slug                 String            @db.VarChar(120)
  excerpt              String            @db.VarChar(500)
  content              Json
  contentFormat        BlogContentFormat
  statusSnapshot       BlogPostStatus
  seoTitle             String?           @db.VarChar(70)
  seoDescription       String?           @db.VarChar(170)
  featuredMediaId      String?           @db.Uuid
  categoryIdsSnapshot  Json
  tagIdsSnapshot       Json
  actorUserId          String            @db.Uuid
  createdAt            DateTime          @default(now())
  post                 BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor                User              @relation("BlogRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([postId, revisionNumber])
  @@index([postId, createdAt(sort: Desc)])
  @@index([actorUserId])
}

model BlogCategory {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(100)
  name           String             @db.VarChar(100)
  normalizedName String             @unique @db.VarChar(100)
  description    String             @default("") @db.VarChar(500)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  posts          BlogPostCategory[]
}

model BlogTag {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique @db.VarChar(100)
  name           String        @db.VarChar(100)
  normalizedName String        @unique @db.VarChar(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  posts          BlogPostTag[]
}

model BlogPostCategory {
  id         String       @id @default(uuid()) @db.Uuid
  postId     String       @db.Uuid
  categoryId String       @db.Uuid
  createdAt  DateTime     @default(now())
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([postId, categoryId])
  @@index([categoryId, postId])
}

model BlogPostTag {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([postId, tagId])
  @@index([tagId, postId])
}

model BlogMediaAsset {
  id               String                 @id @default(uuid()) @db.Uuid
  storageKey       String                 @unique @db.VarChar(240)
  visibility       BlogMediaVisibility    @default(PRIVATE)
  status           BlogMediaStatus        @default(READY)
  originalFilename String                 @db.VarChar(255)
  mimeType         String                 @db.VarChar(100)
  sizeBytes        Int
  width            Int
  height           Int
  altText          String                 @default("") @db.VarChar(300)
  caption          String?                @db.VarChar(500)
  checksum         String                 @db.Char(64)
  uploadedByUserId String                 @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  archivedAt       DateTime?
  uploader         User                   @relation("BlogMediaUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  variants         BlogMediaVariant[]
  postLinks        BlogPostMedia[]
  featuredFor      BlogPost[]             @relation("BlogFeaturedMedia")
  authorProfiles   AuthorProfile[]        @relation("AuthorProfileMedia")

  @@index([uploadedByUserId, visibility, createdAt(sort: Desc)])
  @@index([visibility, status])
  @@index([checksum])
}

model BlogMediaVariant {
  id         String               @id @default(uuid()) @db.Uuid
  mediaId    String               @db.Uuid
  kind       BlogMediaVariantKind
  storageKey String               @unique @db.VarChar(260)
  mimeType   String               @db.VarChar(100)
  sizeBytes  Int
  width      Int
  height     Int
  createdAt  DateTime             @default(now())
  media      BlogMediaAsset       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, kind])
  @@index([mediaId])
}

model BlogPostMedia {
  id        String         @id @default(uuid()) @db.Uuid
  postId    String         @db.Uuid
  mediaId   String         @db.Uuid
  sortOrder Int
  createdAt DateTime       @default(now())
  post      BlogPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media     BlogMediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([postId, mediaId])
  @@unique([postId, sortOrder])
  @@index([mediaId])
}

model BlogSlugRedirect {
  id        String   @id @default(uuid()) @db.Uuid
  oldSlug   String   @unique @db.VarChar(120)
  postId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model QuoteRequestDraft {
  id          String               @id @default(uuid()) @db.Uuid
  tokenHash   String               @unique @db.Char(64)
  sourceHash  String               @db.Char(64)
  startedAt   DateTime             @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  uploads     QuoteRequestUpload[]

  @@index([expiresAt, submittedAt])
}

model QuoteRequest {
  id                     String                      @id @default(uuid()) @db.Uuid
  reference              String                      @unique @db.VarChar(20)
  confirmationTokenHash  String                      @unique @db.Char(64)
  idempotencyKeyHash     String                      @unique @db.Char(64)
  propertyType           QuotePropertyType
  services               Json
  serviceAnswers         Json
  propertyDetails        Json
  addressLine1           String                      @db.VarChar(160)
  addressLine2           String?                     @db.VarChar(160)
  city                   String                      @db.VarChar(80)
  province               String                      @db.VarChar(40)
  postalCode             String                      @db.VarChar(16)
  serviceAreaKey         String                      @db.VarChar(64)
  preferredDates         Json
  notes                  String?                     @db.VarChar(3000)
  customerName           String                      @db.VarChar(120)
  customerEmail          String                      @db.VarChar(254)
  customerPhone          String                      @db.VarChar(32)
  preferredContactMethod String                      @db.VarChar(16)
  companyName            String?                     @db.VarChar(160)
  consentAcceptedAt      DateTime
  status                 QuoteRequestStatus          @default(NEW)
  assignedToUserId       String?                     @db.Uuid
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  archivedAt             DateTime?
  assignedTo             User?                       @relation("QuoteRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  uploads                QuoteRequestUpload[]
  internalNotes          QuoteRequestNote[]
  statusHistory          QuoteRequestStatusHistory[]
  emailMessages          EmailOutbox[]
  estimateResultId       String?                     @unique @db.Uuid
  estimateMatchStatus    EstimateMatchStatus         @default(NOT_LINKED)
  estimateSnapshot       Json?
  estimateResult         EstimateResult?             @relation(fields: [estimateResultId], references: [id], onDelete: SetNull)
  serviceJobs            ServiceJob[]

  @@index([status, createdAt(sort: Desc)])
  @@index([assignedToUserId, status])
  @@index([customerEmail])
  @@index([archivedAt])
}

model PricingVersion {
  id              String                  @id @default(uuid()) @db.Uuid
  versionCode     String                  @unique @db.VarChar(64)
  name            String                  @db.VarChar(160)
  status          PricingVersionStatus    @default(DRAFT)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  publishedAt     DateTime?
  createdByUserId String                  @db.Uuid
  updatedByUserId String                  @db.Uuid
  version         Int                     @default(1)
  notes           String?                 @db.VarChar(2000)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  archivedAt      DateTime?
  createdBy       User                    @relation("PricingVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User                    @relation("PricingVersionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  configurations  ServicePricingConfiguration[]
  estimates       EstimateResult[]

  @@index([status, effectiveFrom, effectiveTo])
}

model ServicePricingConfiguration {
  id                     String         @id @default(uuid()) @db.Uuid
  pricingVersionId       String         @db.Uuid
  serviceKey             String         @db.VarChar(64)
  enabled                Boolean        @default(true)
  baseMinimumCents       Int
  baseMaximumCents       Int
  minimumChargeCents     Int
  maximumEstimatorCents  Int
  roundingIncrementCents Int
  displayOrder           Int            @default(0)
  customerDisclaimer     String         @db.VarChar(1000)
  assumptions            Json
  exclusions             Json
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  pricingVersion         PricingVersion @relation(fields: [pricingVersionId], references: [id], onDelete: Cascade)
  rules                  PricingRule[]

  @@unique([pricingVersionId, serviceKey])
  @@index([pricingVersionId, displayOrder])
}

model PricingRule {
  id                            String                       @id @default(uuid()) @db.Uuid
  servicePricingConfigurationId String                       @db.Uuid
  ruleKey                       String                       @db.VarChar(100)
  questionKey                   String                       @db.VarChar(100)
  ruleType                      PricingRuleType
  conditionOperator             PricingConditionOperator
  comparisonValue               Json?
  minimumAdjustmentCents        Int?
  maximumAdjustmentCents        Int?
  adjustmentBasisPoints         Int?
  sortOrder                     Int
  enabled                       Boolean                      @default(true)
  publicLabel                   String                       @db.VarChar(200)
  internalDescription           String?                      @db.VarChar(1000)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  servicePricingConfiguration   ServicePricingConfiguration @relation(fields: [servicePricingConfigurationId], references: [id], onDelete: Cascade)

  @@unique([servicePricingConfigurationId, ruleKey])
  @@index([servicePricingConfigurationId, sortOrder])
}

model EstimateResult {
  id                    String         @id @default(uuid()) @db.Uuid
  publicTokenHash       String         @unique @db.Char(64)
  transferTokenHash     String?        @unique @db.Char(64)
  transferTokenExpiresAt DateTime?
  idempotencyKeyHash    String         @unique @db.Char(64)
  inputFingerprint      String         @db.Char(64)
  sourceHash            String         @db.Char(64)
  serviceKey            String         @db.VarChar(64)
  customerType          QuotePropertyType
  serviceAreaKey        String         @db.VarChar(64)
  outcome               EstimateOutcome
  minimumCents          Int?
  maximumCents          Int?
  currency              String         @default("CAD") @db.Char(3)
  pricingVersionId      String         @db.Uuid
  pricingVersionCode    String         @db.VarChar(64)
  normalizedInput       Json
  publicExplanation     Json
  calculationTrace      Json
  assumptionsSnapshot   Json
  exclusionsSnapshot    Json
  disclaimerSnapshot    String         @db.VarChar(1000)
  createdAt             DateTime       @default(now())
  expiresAt             DateTime
  archivedAt            DateTime?
  convertedAt           DateTime?
  pricingVersion        PricingVersion @relation(fields: [pricingVersionId], references: [id], onDelete: Restrict)
  quoteRequest          QuoteRequest?

  @@index([createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([pricingVersionId])
  @@index([serviceKey, outcome])
}

model QuoteRequestUpload {
  id               String             @id @default(uuid()) @db.Uuid
  draftId          String?            @db.Uuid
  quoteRequestId   String?            @db.Uuid
  storageKey       String             @unique @db.VarChar(260)
  originalFilename String             @db.VarChar(255)
  mimeType         String             @db.VarChar(100)
  sizeBytes        Int
  width            Int
  height           Int
  checksum         String             @db.Char(64)
  sortOrder        Int
  status           QuoteUploadStatus  @default(READY)
  createdAt        DateTime           @default(now())
  removedAt        DateTime?
  draft            QuoteRequestDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)
  quoteRequest     QuoteRequest?      @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([draftId, status, sortOrder])
  @@index([quoteRequestId, status, sortOrder])
}

model QuoteRequestNote {
  id             String       @id @default(uuid()) @db.Uuid
  quoteRequestId String       @db.Uuid
  authorUserId   String       @db.Uuid
  body           String       @db.VarChar(3000)
  createdAt      DateTime     @default(now())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([quoteRequestId, createdAt(sort: Desc)])
}

model QuoteRequestStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  quoteRequestId String             @db.Uuid
  actorUserId    String             @db.Uuid
  fromStatus     QuoteRequestStatus
  toStatus       QuoteRequestStatus
  createdAt      DateTime           @default(now())
  quoteRequest   QuoteRequest       @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  actor          User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([quoteRequestId, createdAt(sort: Desc)])
}

model PublicRequestThrottle {
  keyHash         String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model EmailOutbox {
  id             String            @id @default(uuid()) @db.Uuid
  quoteRequestId String?           @db.Uuid
  serviceJobId   String?           @db.Uuid
  deduplicationKey String?         @unique @db.VarChar(160)
  templateKey    String            @db.VarChar(64)
  recipient      String            @db.VarChar(254)
  payload        Json
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  lastErrorCode  String?           @db.VarChar(100)
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  quoteRequest   QuoteRequest?     @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  serviceJob     ServiceJob?       @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([quoteRequestId])
  @@index([serviceJobId, createdAt(sort: Desc)])
}

model ServiceJob {
  id                         String                    @id @default(uuid()) @db.Uuid
  referenceNumber            String                    @unique @db.VarChar(22)
  quoteRequestId             String?                   @unique @db.Uuid
  status                     ServiceJobStatus          @default(DRAFT)
  customerType               QuotePropertyType
  customerNameSnapshot       String                    @db.VarChar(120)
  customerEmailSnapshot      String                    @db.VarChar(254)
  customerPhoneSnapshot      String                    @db.VarChar(32)
  companyNameSnapshot        String?                   @db.VarChar(160)
  propertyAddressLine1Snapshot String                  @db.VarChar(160)
  propertyAddressLine2Snapshot String?                 @db.VarChar(160)
  citySnapshot               String                    @db.VarChar(80)
  serviceAreaKey             String                    @db.VarChar(64)
  province                   String                    @default("British Columbia") @db.VarChar(40)
  postalCodeSnapshot         String                    @db.VarChar(16)
  propertyTypeSnapshot       String                    @db.VarChar(80)
  accessNotes                String?                   @db.VarChar(3000)
  serviceScopeSummary        String                    @db.VarChar(4000)
  customerSchedulingNotes    String?                   @db.VarChar(3000)
  internalOperationalNotes   String?                   @db.VarChar(5000)
  scheduledStartAt           DateTime?
  scheduledEndAt             DateTime?
  estimatedDurationMinutes   Int?
  actualArrivalAt            DateTime?
  actualStartAt              DateTime?
  actualEndAt                DateTime?
  completionSummary          String?                   @db.VarChar(4000)
  cancellationReason         String?                   @db.VarChar(1000)
  followUpRequired           Boolean                   @default(false)
  followUpNotes              String?                   @db.VarChar(3000)
  conflictOverrideReason     String?                   @db.VarChar(1000)
  assignedCoordinatorUserId  String?                   @db.Uuid
  createdByUserId            String                    @db.Uuid
  updatedByUserId            String                    @db.Uuid
  version                    Int                       @default(1)
  completedAt                DateTime?
  closedAt                   DateTime?
  archivedAt                 DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  quoteRequest               QuoteRequest?             @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  coordinator                User?                     @relation("ServiceJobCoordinator", fields: [assignedCoordinatorUserId], references: [id], onDelete: SetNull)
  createdBy                  User                      @relation("ServiceJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                  User                      @relation("ServiceJobUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  services                   ServiceJobService[]
  assignments                ServiceJobAssignment[]
  scheduleHistory            ServiceJobScheduleHistory[]
  statusHistory              ServiceJobStatusHistory[]
  notes                      ServiceJobNote[]
  checklistItems             ServiceJobChecklistItem[]
  media                      ServiceJobMedia[]
  incidents                  ServiceJobIncident[]
  activities                 ServiceJobActivity[]
  emailMessages              EmailOutbox[]

  @@index([status, scheduledStartAt])
  @@index([scheduledStartAt, scheduledEndAt])
  @@index([quoteRequestId, status])
  @@index([serviceAreaKey, scheduledStartAt])
  @@index([followUpRequired, status])
  @@index([archivedAt, updatedAt(sort: Desc)])
}

model ServiceJobService {
