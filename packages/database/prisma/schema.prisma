  @@unique([mediaId, kind])
  @@index([mediaId])
}

model BeforeAfterProject {
  id                   String                    @id @default(uuid()) @db.Uuid
  slug                 String                    @unique @db.VarChar(100)
  title                String                    @db.VarChar(160)
  summary              String                    @db.VarChar(500)
  description          String                    @db.Text
  status               BeforeAfterProjectStatus  @default(DRAFT)
  featured             Boolean                   @default(false)
  publishedAt          DateTime?
  completedAt          DateTime?
  serviceKey           String                    @db.VarChar(64)
  serviceAreaKey       String                    @db.VarChar(64)
  primaryBeforeMediaId String?                   @db.Uuid
  primaryAfterMediaId  String?                   @db.Uuid
  seoTitle             String?                   @db.VarChar(70)
  seoDescription       String?                   @db.VarChar(170)
  displayOrder         Int                       @default(0)
  version              Int                       @default(1)
  createdByUserId      String                    @db.Uuid
  updatedByUserId      String                    @db.Uuid
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  archivedAt           DateTime?
  createdBy            User                      @relation("BeforeAfterCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User                      @relation("BeforeAfterUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  primaryBeforeMedia   MediaAsset?               @relation("ProjectPrimaryBefore", fields: [primaryBeforeMediaId], references: [id], onDelete: Restrict)
  primaryAfterMedia    MediaAsset?               @relation("ProjectPrimaryAfter", fields: [primaryAfterMediaId], references: [id], onDelete: Restrict)
  supportingMedia      BeforeAfterProjectMedia[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([featured, status, displayOrder])
  @@index([serviceKey, status])
  @@index([serviceAreaKey, status])
  @@index([primaryBeforeMediaId])
  @@index([primaryAfterMediaId])
}

model BeforeAfterProjectMedia {
  id        String                   @id @default(uuid()) @db.Uuid
  projectId String                   @db.Uuid
  mediaId   String                   @db.Uuid
