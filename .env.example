# Runtime mode
NODE_ENV=development

# Local PostgreSQL container (development values only)
POSTGRES_USER=ctps
POSTGRES_PASSWORD=ctps_local_development_only
POSTGRES_DB=ctps
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ctps:ctps_local_development_only@localhost:5432/ctps?schema=public&connect_timeout=2

# Application ports and URLs
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://127.0.0.1:4000

# Staff authentication (set AUTH_COOKIE_SECURE=true for every production deployment)
AUTH_SESSION_COOKIE_NAME=ctps_admin_session
# Leave blank on localhost. In production, set the shared parent domain only when admin/API use subdomains.
AUTH_SESSION_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_SECONDS=28800
AUTH_SESSION_ABSOLUTE_SECONDS=604800
AUTH_ACTIVITY_UPDATE_SECONDS=300
AUTH_SESSION_CLEANUP_SECONDS=3600
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_MAX_ATTEMPTS=8

# Comma-separated browser origins accepted by the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Phase 5 managed before-and-after media (private/public roots must be persistent in production)
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_PUBLIC_ROOT=../../storage/public/before-after
MEDIA_LOCAL_PRIVATE_ROOT=../../storage/private/before-after
MEDIA_MAX_FILE_BYTES=10485760
MEDIA_MAX_UPLOAD_FILES=10
MEDIA_MAX_PROJECT_SUPPORTING_IMAGES=12
MEDIA_MAX_TOTAL_UPLOAD_BYTES=52428800
MEDIA_MIN_WIDTH=600
MEDIA_MIN_HEIGHT=400
MEDIA_MAX_WIDTH=12000
MEDIA_MAX_HEIGHT=12000
MEDIA_IMAGE_QUALITY=82
MEDIA_PUBLIC_BASE_PATH=/media/before-after

# Phase 6 guest quote requests (private media root must be persistent and never web-served)
QUOTE_PRIVATE_MEDIA_ROOT=../../storage/private/quote-requests
QUOTE_DRAFT_TTL_SECONDS=86400
QUOTE_MIN_COMPLETION_SECONDS=8
QUOTE_RATE_LIMIT_MAX_ATTEMPTS=12
QUOTE_RATE_LIMIT_WINDOW_SECONDS=900
QUOTE_MAX_UPLOAD_FILES=8
QUOTE_MAX_FILE_BYTES=8388608
QUOTE_MAX_TOTAL_UPLOAD_BYTES=33554432

# Phase 7 preliminary estimator (opaque result/transfer tokens are stored only as hashes)
ESTIMATOR_RESULT_TTL_SECONDS=604800
ESTIMATOR_TRANSFER_TTL_SECONDS=1800
ESTIMATOR_RATE_LIMIT_MAX_ATTEMPTS=20
ESTIMATOR_RATE_LIMIT_WINDOW_SECONDS=900

# Phase 8 managed blog publishing and dedicated private/public media
BLOG_ENABLED=true
BLOG_LOCAL_PUBLIC_ROOT=../../storage/public/blog
BLOG_LOCAL_PRIVATE_ROOT=../../storage/private/blog
BLOG_MAX_UPLOAD_FILES=10
BLOG_MAX_FILE_BYTES=10485760
BLOG_MAX_TOTAL_UPLOAD_BYTES=52428800
BLOG_MIN_IMAGE_WIDTH=600
BLOG_MIN_IMAGE_HEIGHT=400
BLOG_MAX_IMAGE_WIDTH=12000
BLOG_MAX_IMAGE_HEIGHT=12000
BLOG_IMAGE_QUALITY=82
BLOG_SCHEDULE_BATCH_SIZE=20
BLOG_SEARCH_MAX_QUERY_LENGTH=100
BLOG_PUBLIC_PAGE_SIZE=12
BLOG_ADMIN_PAGE_SIZE=20
JOBS_ENABLED=true
JOBS_TIME_ZONE=America/Vancouver
JOBS_DEFAULT_DURATION_MINUTES=180
JOBS_MIN_DURATION_MINUTES=30
JOBS_MAX_DURATION_MINUTES=960
JOBS_ADMIN_PAGE_SIZE=20
JOBS_CALENDAR_RANGE_DAYS=42
JOBS_PRIVATE_MEDIA_ROOT=../../storage/private/jobs
JOBS_MAX_UPLOAD_FILES=10
JOBS_MAX_FILE_BYTES=10485760
JOBS_MAX_TOTAL_UPLOAD_BYTES=52428800
JOBS_MIN_IMAGE_WIDTH=600
JOBS_MIN_IMAGE_HEIGHT=400
JOBS_MAX_IMAGE_WIDTH=12000
JOBS_MAX_IMAGE_HEIGHT=12000
JOBS_IMAGE_QUALITY=82
JOBS_REFERENCE_PREFIX=JOB
JOBS_REMINDER_HOURS_BEFORE=24
JOBS_REMINDER_BATCH_SIZE=25

# Email delivery: smtp, log-safe, or disabled. Use smtp in production.
EMAIL_DELIVERY_MODE=log-safe
EMAIL_FROM=quotes@example.invalid
QUOTE_STAFF_EMAIL=quotes@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
