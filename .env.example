# Runtime mode
NODE_ENV=development

# Local PostgreSQL container (development values only)
POSTGRES_USER=ctps
POSTGRES_PASSWORD=ctps_local_development_only
POSTGRES_DB=ctps
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ctps:ctps_local_development_only@localhost:5432/ctps?schema=public&connect_timeout=2

# Application ports and URLs
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://127.0.0.1:4000

# Comma-separated browser origins accepted by the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
