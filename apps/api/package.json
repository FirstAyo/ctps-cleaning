{
  "name": "@ctps/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "cross-env NODE_ENV=production dotenv -e ../../.env -- node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "auth:initialize": "dotenv -e ../../.env -- tsx src/cli/initialize-auth.ts",
    "auth:bootstrap-super-admin": "dotenv -e ../../.env -- tsx src/cli/bootstrap-super-admin.ts",
    "verify:auth-runtime": "dotenv -e ../../.env -- tsx src/cli/verify-auth-runtime.ts",
    "verify:before-after-runtime": "dotenv -e ../../.env -- tsx src/cli/verify-before-after-runtime.ts",
    "verify:quote-request-runtime": "dotenv -e ../../.env -- tsx src/cli/verify-quote-request-runtime.ts",
    "estimator:initialize-development": "dotenv -e ../../.env -- tsx src/cli/initialize-estimator-development.ts",
    "verify:estimator-runtime": "dotenv -e ../../.env -- tsx src/cli/verify-estimator-runtime.ts",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@ctps/database": "workspace:*",
    "@ctps/email": "workspace:*",
    "@ctps/permissions": "workspace:*",
    "@ctps/pricing": "workspace:*",
    "@ctps/types": "workspace:*",
    "@ctps/validation": "workspace:*",
    "@inquirer/prompts": "^8.5.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@node-rs/argon2": "^2.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
