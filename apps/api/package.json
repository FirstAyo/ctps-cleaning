{
  "name": "@ctps/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "cross-env NODE_ENV=production dotenv -e ../../.env -- node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@ctps/database": "workspace:*",
    "@ctps/types": "workspace:*",
    "@ctps/validation": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.28",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
