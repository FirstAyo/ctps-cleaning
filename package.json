{
  "name": "ctps-cleaning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --concurrency=12",
    "build": "turbo run build",
    "lint": "eslint scripts && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:runtime": "dotenv -e .env -- node scripts/verify-runtime.mjs",
    "verify:database-outage": "dotenv -e .env -- node scripts/verify-runtime.mjs --expect-database-unavailable",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @ctps/database db:generate",
    "db:migrate": "pnpm --filter @ctps/database db:migrate",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @ctps/database db:migrate:deploy",
    "db:push": "pnpm --filter @ctps/database db:push",
    "db:studio": "pnpm --filter @ctps/database db:studio",
    "auth:initialize": "pnpm --filter @ctps/api auth:initialize",
    "auth:bootstrap-super-admin": "pnpm --filter @ctps/api auth:bootstrap-super-admin",
    "marketing:initialize": "pnpm --filter @ctps/api marketing:initialize",
    "verify:marketing-media-runtime": "pnpm --filter @ctps/api verify:marketing-media-runtime",
    "verify:auth-runtime": "pnpm --filter @ctps/api verify:auth-runtime",
    "verify:before-after-runtime": "pnpm --filter @ctps/api verify:before-after-runtime",
    "verify:quote-request-runtime": "pnpm --filter @ctps/api verify:quote-request-runtime",
    "estimator:initialize-development": "pnpm --filter @ctps/api estimator:initialize-development",
    "verify:estimator-runtime": "pnpm --filter @ctps/api verify:estimator-runtime",
    "blog:publish-due": "pnpm --filter @ctps/api blog:publish-due",
    "jobs:send-reminders": "pnpm --filter @ctps/api jobs:send-reminders",
    "verify:jobs-runtime": "pnpm --filter @ctps/api verify:jobs-runtime",
    "verify:blog-runtime": "pnpm --filter @ctps/api verify:blog-runtime",
    "environment:validate": "dotenv -e .env -- pnpm --filter @ctps/api environment:validate",
    "environment:validate:production": "dotenv -e .env.production -- pnpm --filter @ctps/api environment:validate",
    "email:process-outbox": "pnpm --filter @ctps/api email:process-outbox",
    "maintenance:cleanup-dry-run": "pnpm --filter @ctps/api maintenance:cleanup-dry-run",
    "backup:database": "sh scripts/deployment/backup-database.sh",
    "backup:media": "sh scripts/deployment/backup-media.sh",
    "smoke": "node scripts/smoke-test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.2",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
